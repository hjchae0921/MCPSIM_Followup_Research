  "formulation": {
    "weak_form": [
      {
        "field": "u",
        "unknown": "\\mathbf{u}",
        "test_function": "\\mathbf{v}",
        "type": "linear",
        "bilinear_form": "a_u(U,\\mathbf{v})=\\int_{\\Omega} \\boldsymbol{\\sigma}(\\mathbf{u}):\\boldsymbol{\\varepsilon}(\\mathbf{v})\\,d\\Omega+\\int_{\\Gamma_R^u}(\\mathbf{K}_R\\mathbf{u})\\cdot\\mathbf{v}\\,d\\Gamma",
        "linear_form": "L_u(\\mathbf{v})=\\int_{\\Omega}\\mathbf{b}\\cdot\\mathbf{v}\\,d\\Omega+\\int_{\\Gamma_N^u}\\bar{\\mathbf{t}}\\cdot\\mathbf{v}\\,d\\Gamma+\\int_{\\Gamma_R^u}(\\mathbf{K}_R\\mathbf{u}_R)\\cdot\\mathbf{v}\\,d\\Gamma"
      }
    ],
    "kinematics": [
      "\\boldsymbol{\\varepsilon}(\\mathbf{u})=\\frac{1}{2}\\left(\\nabla\\mathbf{u}+\\nabla\\mathbf{u}^{T}\\right)"
    ],
    "constitutive": [
      "\\boldsymbol{\\sigma}(\\mathbf{u})=\\mathbb{C}:\\boldsymbol{\\varepsilon}(\\mathbf{u})",
      "\\mathbb{C}:\\boldsymbol{\\varepsilon}=\\lambda\\,\\operatorname{tr}(\\boldsymbol{\\varepsilon})\\mathbf{I}+2\\mu\\boldsymbol{\\varepsilon}",
      "\\lambda=\\frac{E\\nu}{(1+\\nu)(1-2\\nu)},\\qquad \\mu=\\frac{E}{2(1+\\nu)}"
    ],
    "constitutive_parameters": [
      {
        "name": "youngs_modulus",
        "symbol": "E"
